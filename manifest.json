{
  "manifest_version": 3,
  "name": "Nitrate",
  "version": "3.0.0",
  "description": "Unlocks the highest video and audio Netflix will actually serve your hardware — resolution, bitrate, surround sound and every track.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["*://*.netflix.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nitrate"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["core.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
